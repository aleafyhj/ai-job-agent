JOB_AGENT_APP_NAME=AI Job Agent
JOB_AGENT_ENVIRONMENT=development
JOB_AGENT_HOST=127.0.0.1
JOB_AGENT_PORT=8000
JOB_AGENT_LOG_LEVEL=INFO
# Vision defaults: Qwen3-VL Plus / mainland China endpoint.
# Existing system DASHSCOPE_API_KEY is read automatically (never commit its value).
# JOB_AGENT_VISION_MODEL=qwen3-vl-plus
# JOB_AGENT_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for profile, resume and policy APIs; at least 32 characters.
# JOB_AGENT_API_TOKEN=YOUR_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
# JOB_AGENT_ARTIFACTS_DIR=D:/lenovo/code/ai-job-agent/artifacts
# Create a dedicated database/user, then set your real local URL in .env.
# JOB_AGENT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/ai_job_agent
